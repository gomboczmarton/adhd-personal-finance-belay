{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adhd-finance-harness/schemas/yearly-bank.schema.json",
  "title": "Yearly spending bank frontmatter (finance/knowledge/yearly-bank.md)",
  "description": "Recurring non-monthly items (annual/quarterly) with their due months; monthly planning surfaces the ones due, highlighted, per plan.md.",
  "type": "object",
  "required": ["schema_version", "items"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "due_months", "typical_amount", "currency"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "name": {"type": "string"},
          "category": {"type": "string", "description": "Canonical category key."},
          "due_months": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "integer", "minimum": 1, "maximum": 12},
            "description": "Months (1-12) the item is due; multiple entries = quarterly/half-yearly items."
          },
          "typical_amount": {"type": "number", "exclusiveMinimum": 0},
          "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
          "source": {
            "enum": ["detected", "user"],
            "description": "detected = found in historical transactions during onboarding; user = told by the user."
          },
          "last_confirmed": {"type": "string", "pattern": "^\\d{4}-\\d{2}$"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
