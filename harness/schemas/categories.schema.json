{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adhd-finance-harness/schemas/categories.schema.json",
  "title": "Category taxonomy frontmatter (finance/knowledge/categories.md)",
  "description": "Canonical English category keys with per-user display names in the user's language (D6). Keys are stable identifiers used everywhere else; display names are presentation only.",
  "type": "object",
  "required": ["schema_version", "categories"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key"],
        "additionalProperties": false,
        "properties": {
          "key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$"},
          "display": {"type": "string", "description": "Name in the user's language; key shown if omitted."},
          "parent": {"type": "string", "description": "Parent category key for groupings."},
          "kind": {"enum": ["need", "want", "goal"], "description": "Optional coaching lens."},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
