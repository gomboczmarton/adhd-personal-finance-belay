{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adhd-finance-harness/schemas/event.schema.json",
  "title": "Ledger event (one line of finance/ledger/events.jsonl)",
  "description": "Append-only money facts. txn.imported identity is a content hash (account + date + amount + description) so re-imported overlapping exports dedup naturally. Mistakes are corrected by appending compensating events, never by editing lines.",
  "type": "object",
  "required": ["v", "ts", "type"],
  "properties": {
    "v": {"const": 1},
    "ts": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}"},
    "type": {
      "enum": [
        "txn.imported",
        "txn.categorized",
        "txn.matched",
        "strategy.adopted",
        "decision.logged"
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "txn.imported"}}},
      "then": {
        "required": ["account", "hash", "date", "amount", "currency", "desc"],
        "properties": {
          "account": {"type": "string"},
          "hash": {"type": "string", "pattern": "^[a-f0-9]{16}$"},
          "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "amount": {"type": "number", "description": "Signed; negative = money out."},
          "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
          "desc": {"type": "string"},
          "counterparty": {"type": "string"},
          "source_file": {"type": "string", "description": "Basename of the export the row came from."}
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "txn.categorized"}}},
      "then": {
        "required": ["hash", "category", "kind", "by"],
        "properties": {
          "hash": {"type": "string", "pattern": "^[a-f0-9]{16}$"},
          "category": {"type": "string"},
          "kind": {"enum": ["expense", "income", "internal_transfer", "refund"]},
          "by": {"enum": ["user", "agent", "rule"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "rule": {"type": "string", "description": "merchant-map pattern that fired, when by=rule."}
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "txn.matched"}}},
      "then": {
        "required": ["hashes", "kind"],
        "properties": {
          "hashes": {
            "type": "array",
            "minItems": 2,
            "items": {"type": "string", "pattern": "^[a-f0-9]{16}$"},
            "description": "The paired legs of an internal transfer (envelope refill, debit<->credit move)."
          },
          "kind": {"enum": ["internal_transfer"]},
          "by": {"enum": ["user", "agent", "rule"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "strategy.adopted"}}},
      "then": {
        "required": ["scope", "strategy"],
        "properties": {
          "scope": {"type": "string", "description": "Category key, or 'all'."},
          "strategy": {"enum": ["awareness", "envelope"]},
          "envelope": {"type": "string"}
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "decision.logged"}}},
      "then": {
        "required": ["text"],
        "properties": {"text": {"type": "string"}}
      }
    }
  ]
}
